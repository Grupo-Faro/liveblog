#. Plugin Name of the plugin/theme
#: liveblog.php:665
msgid "Liveblog"
msgstr "Liveblog"

#: liveblog.php:681
msgid "Enable"
msgstr "Activar"

#: liveblog.php:682
msgid "Enables liveblog on this post. Posting tools are enabled for editors, visitors get the latest updates."
msgstr "Activa Liveblog en esta entrada. Las herramientas de publicación están activadas para los editores; los visitantes solo obtienen las últimas actualizaciones."

#: liveblog.php:682
msgid "There is an <strong>enabled</strong> liveblog on this post. <a href=\"%s\">Visit the liveblog &rarr;</a>"
msgstr "Hay un liveblog <strong>activado</strong> en esta entrada. <a href=\"%s\">Visita el liveblog &rarr;</a>"

#: liveblog.php:683
msgid "Archive"
msgstr "Archivar"

#: liveblog.php:684
msgid "Archives the liveblog on this post. Visitors still see the liveblog entries, but posting tools are hidden."
msgstr "Archiva el liveblog en esta entrada. Los visitantes todavía ven las entradas del liveblog, pero las herramientas de publicación están ocultas."

#: liveblog.php:684
msgid "There is an <strong>archived</strong> liveblog on this post. <a href=\"%s\">Visit the liveblog archive &rarr;</a>"
msgstr "Hay un liveblog <strong>archivado</strong> en esta entrada. <a href=\"%s\">Visita el liveblog archivado &rarr;</a>"

#: liveblog.php:690
msgid "This is a normal WordPress post, without a liveblog."
msgstr "Esta es una entrada normal de WordPress, sin liveblog."

#: liveblog.php:750
msgid "Cheatin', uh?"
msgstr "Haciendo trampas, ¿eh?"

#: liveblog.php:761
msgid "Sorry, we could not authenticate you."
msgstr "Lo sentimos, pero no podemos autenticarte."

#: templates/liveblog-form.php:9
msgid "Preview"
msgstr "Vista previa"

#: templates/liveblog-form.php:13
msgid "Remember: keep it short! To insert an image, drag and drop it here."
msgstr "Recuerda: sé breve. Para insertar una imagen, arrástrala y suéltala aquí."

#: templates/liveblog-loop.php:3
msgid "<strong>This liveblog is archived.</strong> If you need to publish new updates or edit or delete the old ones, you need to <a href=\"%s\">enable it first</a>."
msgstr "<strong>Este liveblog está archivado.</strong> Si necesitas publicar nuevas actualizaciones o editar o borrar las anteriores, necesitas <a href=\"%s\">activarlo primero</a>."

#: templates/liveblog-single-entry.php:12
msgid "Edit"
msgstr "Editar"

#: templates/liveblog-single-entry.php:12
msgid "Delete"
msgstr "Borrar"

#: templates/old-wp-notice.php:3
msgid "Your current WordPress is version %1$s, which is too old to run the liveblog plugin. The minimum required version is %2$s. Please, either <a href=\"%3$s\">update WordPress</a>, or <a href=\"%4$s\">deactivate the liveblog plugin</a>."
msgstr "Tu versión actual de WordPres es la %1$s, que es demasiado antigua para ejecutar el plugin Liveblog. La versión mínima requerida es la %2$s. Por favor, o bien <a href=\"%3$s\">actualiza WordPress</a>, o <a href=\"%4$s\">desactiva el plugin Liveblog</a>."

#. Plugin URI of the plugin/theme
msgid "http://wordpress.org/extend/plugins/liveblog/"
msgstr "http://wordpress.org/extend/plugins/liveblog/"

#. Description of the plugin/theme
msgid "Blogging: at the speed of live."
msgstr "Blogging a la velocidad de la vida."

#. Author of the plugin/theme
msgid "WordPress.com VIP, Automattic"
msgstr "WordPress.com VIP, Automattic"

#. Author URI of the plugin/theme
msgid "http://vip.wordpress.com/"
msgstr "http://vip.wordpress.com/"

